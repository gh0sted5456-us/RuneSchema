{
  "title": "RuneSchema DataAsset field patch",
  "description": "A mod-owned document keyed by a full cooked DA_ object or generated-class path. No web schema URL or mod identifier is required.",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^/Game/.*/DA_[^/]+\\.DA_[^/]+(?:_C)?$": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "anyOf": [
          {},
          {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "$Set": {},
              "$Merge": { "type": "object" },
              "$Append": {},
              "$AppendUnique": {},
              "$MergeWhere": {
                "type": "object",
                "required": ["Field", "Values", "Value"],
                "properties": {
                  "Field": { "type": "string", "minLength": 1 },
                  "Values": { "type": "array", "minItems": 1, "uniqueItems": true },
                  "Value": { "type": "object", "minProperties": 1 }
                },
                "additionalProperties": false
              },
              "$Operations": { "type": "array", "maxItems": 1024 },
              "$Identity": { "type": "string" },
              "$TemplateIndex": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}

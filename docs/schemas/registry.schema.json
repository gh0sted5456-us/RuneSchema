{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "modOwnedCookedPaths": {
      "description": "Runtime requires the owning /Owner/ or /Game/Mods/Owner/ namespace and rejects case-insensitive duplicates. Strings only; no Source:Schema or arbitrary property writes.",
      "items": {
        "maxLength": 1024,
        "not": {
          "pattern": "\\.\\."
        },
        "pattern": "^/(?!Script/|Engine/)[A-Za-z0-9_.-]+/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "maxItems": 4096,
      "type": "array",
      "uniqueItems": true
    }
  },
  "description": "Enabled loose schema mods and cooked declarations share native-registry enrollment and client/server declarations. Every asset still requires a correct live type and verified native identity; a declaration does not construct an asset or authorize cleanup.",
  "properties": {
    "Entries": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "not": {
                "required": [
                  "Relay"
                ]
              }
            },
            "if": {
              "properties": {
                "Kind": {
                  "const": "DataRelay"
                }
              }
            },
            "then": {
              "maxProperties": 3,
              "required": [
                "Relay"
              ]
            }
          }
        ],
        "anyOf": [
          {
            "required": [
              "Presentation"
            ]
          },
          {
            "required": [
              "Authority"
            ]
          },
          {
            "required": [
              "Relay"
            ]
          }
        ],
        "properties": {
          "Authority": {
            "additionalProperties": false,
            "properties": {
              "Action": {
                "enum": [
                  "SpawnFollower",
                  "ExecuteGraph",
                  "ConsumedItemAuthority"
                ]
              },
              "Bindings": {
                "additionalProperties": {
                  "pattern": "^/(?:Game|DowdunReach|FutureMajorVersion)/",
                  "type": "string"
                },
                "maxProperties": 32,
                "type": "object"
              },
              "DataAsset": {
                "maxLength": 1024,
                "pattern": "^/[A-Za-z0-9_.-]+/[^\\r\\n\\t]+$",
                "type": "string"
              },
              "Function": {
                "default": "Trigger",
                "pattern": "^[A-Za-z0-9_.-]+$",
                "type": "string"
              },
              "GraphClass": {
                "pattern": "^/[A-Za-z0-9_.-]+/.+_C$",
                "type": "string"
              }
            },
            "required": [
              "Action",
              "GraphClass"
            ],
            "type": "object"
          },
          "Id": {
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "type": "string"
          },
          "Kind": {
            "enum": [
              "SpellPresentation",
              "PersistentEffect",
              "WeatherPresentation",
              "AudioPresentation",
              "CosmeticWrapper",
              "DataRelay",
              "GameplayAuthority"
            ]
          },
          "Metadata": {
            "maxProperties": 32,
            "type": "object"
          },
          "Presentation": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "Class": {
                  "pattern": "^/(?:Game|DowdunReach|FutureMajorVersion)/",
                  "type": "string"
                },
                "Classification": {
                  "enum": [
                    "PureVFX",
                    "CosmeticWrapper",
                    "NativeReplicated",
                    "Unsupported"
                  ]
                },
                "Parameters": {
                  "maxProperties": 32,
                  "type": "object"
                },
                "Phase": {
                  "maxLength": 96,
                  "pattern": "^[A-Za-z0-9_.-]+$",
                  "type": "string"
                },
                "Socket": {
                  "maxLength": 128,
                  "type": "string"
                }
              },
              "required": [
                "Phase",
                "Class",
                "Classification"
              ],
              "type": "object"
            },
            "maxItems": 64,
            "minItems": 1,
            "type": "array"

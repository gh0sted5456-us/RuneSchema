              "Broadcast": {
                "default": false,
                "type": "boolean"
              },
              "Channel": {
                "maxLength": 96,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.-]+$",
                "type": "string"
              },
              "ClientPublish": {
                "default": false,
                "type": "boolean"
              },
              "MaxBytes": {
                "default": 65536,
                "maximum": 65536,
                "minimum": 1,
                "type": "integer"
              },
              "Snapshot": {
                "default": false,
                "type": "boolean"
              },
              "Version": {

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "additionalProperties": true,
      "patternProperties": {
        "^[^$]": {
          "additionalProperties": true,
          "patternProperties": {
            "^[^$]": {
              "additionalProperties": true,
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    {
      "items": {
        "additionalProperties": true,
        "patternProperties": {
          "^[^$]": {
            "additionalProperties": true,
            "patternProperties": {
              "^[^$]": {
                "additionalProperties": true,
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  ],
  "description": "Structural authoring hints, not an exhaustive runtime validator. Asset paths, identities, reflected properties and event compatibility must be validated in game.",
  "title": "RuneSchema /raw",
  "x-runeschema-coverage": "structural",
  "x-runeschema-starter-capabilities": {
    "append": true,
    "clone": false,
    "patch": true,
    "search": "loaded records"
  }
}
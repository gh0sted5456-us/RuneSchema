{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Structural authoring hints, not an exhaustive runtime validator. Asset paths, identities, reflected properties and event compatibility must be validated in game.",
  "items": {
    "additionalProperties": true,
    "allOf": [
      {
        "if": {
          "required": [
            "EventOnly"
          ]
        },
        "then": {
          "additionalProperties": false,
          "properties": {
            "AIClass": {
              "pattern": "^/",
              "type": "string"
            },
            "BossName": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "DisplayName": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "EventOnly": {
              "const": true
            },
            "GroundMigrationRadius": {
              "default": 300,
              "description": "Bounded nearby collision-clear placement radius in centimetres; 0 disables relocation. Native capsule or GroundClearance required. Authored location and identity remain unchanged.",
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            "Id": {
              "type": "string"
            },
            "LootRow": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\r\\n\\t]+$",
              "type": "string"
            },
            "PowerLevel": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "Scale": {
              "maximum": 100,
              "minimum": 0.01,
              "type": "number"
            },
            "Type": {
              "const": "AISpawnPoint"
            },
            "VisualEffect": {
              "additionalProperties": false,
              "description": "All NPC visual types. Applies to meshes, including human equipment/weapons, not nameplate widgets. Enable Overlay or BodyMaterial.",
              "properties": {
                "BodyMaterial": {
                  "default": false,
                  "type": "boolean"
                },
                "MainColor": {
                  "additionalProperties": false,
                  "properties": {
                    "A": {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "B": {
                      "maximum": 64,
                      "minimum": 0,
                      "type": "number"
                    },
                    "G": {
                      "maximum": 64,
                      "minimum": 0,
                      "type": "number"
                    },
                    "R": {
                      "maximum": 64,
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "R",
                    "G",
                    "B",
                    "A"
                  ],
                  "type": "object"
                },
                "Overlay": {
                  "default": true,
                  "type": "boolean"
                },
                "SecondaryColor": {
                  "additionalProperties": false,
                  "properties": {
                    "A": {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "B": {
                      "maximum": 64,
                      "minimum": 0,
                      "type": "number"
                    },
                    "G": {
                      "maximum": 64,
                      "minimum": 0,
                      "type": "number"
                    },
                    "R": {
                      "maximum": 64,
                      "minimum": 0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "R",
                    "G",
                    "B",
                    "A"
                  ],
                  "type": "object"
                },
                "Type": {
                  "const": "Ghost Glow"
                }
              },
              "required": [
                "Type"
              ],
              "type": "object"
            }
          },
          "required": [
            "Id",
            "Type",
            "EventOnly",
            "AIClass"
          ],
          "type": "object"
        }
      },
      {
        "if": {
          "properties": {
            "Type": {
              "const": "BuildingPiece"
            }
          },
          "required": [
            "Type"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "QuestActive"
                ]
              },
              {
                "required": [
                  "EventActive"
                ]
              }
            ]
          },
          "properties": {
            "AllowDeconstruction": {
              "const": true
            },
            "DuplicateRadius": {
              "exclusiveMinimum": 0
            },
            "PersistAfterCondition": {
              "const": true
            },
            "TimeOfDay": {
              "const": "Any"
            },
            "UseNativeRespawn": {
              "const": false
            }
          },
          "required": [
            "Id",
            "Type",
            "Building",
            "Location"
          ]
        }
      }
    ],
    "dependencies": {
      "DuplicateRadius": {
        "anyOf": [
          {
            "required": [
              "QuestCompleted"
            ]
          },
          {
            "properties": {
              "Type": {
                "const": "BuildingPiece"
              }
            },
            "required": [
              "Type"
            ]
          }
        ]
      },
      "PersistAfterCondition": {
        "required": [
          "QuestCompleted"
        ]
      },
      "SpawnRadiusMeters": {
        "not": {
          "anyOf": [
            {
              "required": [
                "MinSpawnDistance"
              ]
            },
            {
              "required": [
                "MaxSpawnDistance"
              ]
            },
            {
              "required": [
                "EventOnly"
              ]
            }
          ]
        },
        "properties": {
          "RequiresActivation": {
            "const": false
          },
          "Type": {
            "const": "AISpawnPoint"
          }
        },
        "required": [
          "Type"
        ]
      }
    },
    "properties": {
      "AdditionalDrops": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "ChancePercent": {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            "Item": {
              "pattern": "^/[^\\r\\n\\t]+\\.[^\\r\\n\\t]+$",
              "type": "string"
            },
            "Max": {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            "Min": {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "Item",
            "Min",
            "Max",
            "ChancePercent"
          ],
          "type": "object"
        },
        "maxItems": 16,
        "type": "array"
      },
      "Building": {
        "description": "BuildingPieceData asset path for transient BuildingProp or permanent native BuildingPiece placements.",
        "pattern": "^/",
        "type": "string"
      },
      "DuplicateRadius": {
        "default": 100,
        "description": "BuildingPiece skips creation when any native building occupies this radius in centimetres (grounded: XY column; ungrounded: XYZ). Must be positive for BuildingPiece. Quest-activated Actor/BuildingProp retain same-class checks; zero disables those checks.",
        "maximum": 10000,
        "minimum": 0,
        "type": "number"
      },
      "EventActive": {
        "description": "Temporary Actor resource exists only while the named RuneSchema event runs in this world. A local Id is qualified with the mod name. It is excluded from world saves and removed when the event ends or is cancelled.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "Grid": {
        "additionalProperties": false,
        "properties": {
          "Columns": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "Rows": {
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "SpacingMeters": {
            "maximum": 1000,
            "minimum": 0.1,
            "type": "number"
          }
        },
        "required": [
          "Rows",
          "Columns",
          "SpacingMeters"
        ],
        "type": "object"
      },
      "GroundClearance": {
        "additionalProperties": false,
        "description": "Unscaled capsule clearance envelope above the surface for props/resources without an owned native capsule. HalfHeight must be at least Radius; verify native/runtime geometry.",
        "properties": {
          "HalfHeight": {
            "maximum": 100000,
            "minimum": 0.1,
            "type": "number"
          },
          "Radius": {
            "maximum": 10000,
            "minimum": 0.1,
            "type": "number"
          }
        },
        "required": [
          "Radius",
          "HalfHeight"
        ],
        "type": "object"
      },
      "GroundMigrationRadius": {
        "default": 300,
        "description": "Bounded nearby collision-clear placement radius in centimetres; 0 disables relocation. Native capsule or GroundClearance required. Authored location and identity remain unchanged.",
        "maximum": 1000,
        "minimum": 0,
        "type": "number"
      },
      "GroundOffset": {
        "default": 0,
        "description": "Centimetre offset above or below the resolved ground. Do not combine with the Location.Z $+offset shorthand.",
        "maximum": 100000,
        "minimum": -100000,
        "type": "number"
      },
      "GroundReferenceZ": {
        "description": "Approximate floor height in centimetres, not a placement fallback. Selects collision below this height plus a 45 cm stair allowance. For bare $ without a hint, use the landscape beneath overhead roofs and bridges.",
        "maximum": 100000000,
        "minimum": -100000000,
        "type": "number"
      },
      "GroundToSurface": {
        "default": true,
        "description": "Trace the authored X/Y placement onto blocking ground before spawning. Disable only for intentionally airborne actors.",
        "type": "boolean"
      },
      "Location": {
        "description": "World coordinates as [X,Y,Z] or {X,Y,Z}. Z accepts $, $+offset, or $-offset and resolves to blocking ground.",
        "oneOf": [
          {
            "additionalItems": false,
            "items": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "pattern": "^\\$([+-][0-9]+(?:\\.[0-9]+)?)?$",
                    "type": "string"
                  }
                ]
              }
            ],
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          {
            "additionalProperties": false,
            "properties": {
              "X": {
                "type": "number"
              },
              "Y": {
                "type": "number"
              },
              "Z": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "pattern": "^\\$([+-][0-9]+(?:\\.[0-9]+)?)?$",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "X",
              "Y",
              "Z"
            ],
            "type": "object"
          }
        ]
      },
      "PersistAfterCondition": {
        "default": true,
        "description": "Latch a completed quest condition so an activated placement remains available. Set false for a placement that should exist only while the completion state is observable.",
        "type": "boolean"
      },
      "PowerLevel": {
        "description": "Native Dominion AI spawn power level. Supported on AISpawnPoint entries and validated for every authored ID.",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "QuestActive": {
        "description": "Temporary Actor resource exists only while a RuneSchema quest is Given to a connected participant. A local Id is qualified with the mod name. Requires a cooked subclass of the game's ore-node or fellable-tree base with SpudGuid and bSkipSpudStore. The actor is excluded from world saves and removed when the quest is no longer active.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "QuestCompleted": {
        "description": "Activate this placement after a local Id or Mod:Id quest is completed by a connected participant. Quest-linked BuildingProp actors are transient: RuneSchema recreates them while the quest definition is available, and they leave no saved collision shell when that quest or mod is removed. Combines with TimeOfDay when both are present.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "Rotation": {
        "additionalProperties": false,
        "description": "Unreal rotator in degrees. Use the named Pitch, Yaw and Roll fields.",
        "properties": {
          "Pitch": {
            "type": "number"
          },
          "Roll": {
            "type": "number"
          },
          "Yaw": {
            "type": "number"
          }
        },
        "required": [
          "Pitch",
          "Yaw",
          "Roll"
        ],
        "type": "object"
      },
      "Scale": {
        "anyOf": [
          {
            "maximum": 100,
            "minimum": 0.01,
            "type": "number"
          },
          {
            "items": {
              "maximum": 100,
              "minimum": 0.01,
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          }
        ],
        "description": "Uniform number or XYZ actor scale. Every component accepts 0.01 through 100."
      },
      "SpawnRadiusMeters": {
        "description": "Ordinary AISpawnPoint native proximity eligibility radius in metres. Minimum distance becomes zero; external activation is disabled. Cannot combine with MinSpawnDistance, MaxSpawnDistance or raw radius/activation Properties. Native streaming, navigation, population and respawn rules still apply; not a guaranteed one-shot ambush trigger.",
        "maximum": 10000,
        "minimum": 0.01,
        "type": "number"
      },
      "TimeOfDay": {
        "default": "Any",
        "description": "Authority-controlled lifecycle gate for AI spawn points, resource actors, and functional BuildingProp entries. Timed actors are transient and cannot use native respawn persistence.",
        "enum": [
          "Any",
          "Day",
          "Night"
        ]
      }
    },
    "type": "object"
  },
  "title": "RuneSchema /spawns",
  "type": "array",
  "x-runeschema-coverage": "structural",
  "x-runeschema-starter-capabilities": {
    "append": false,
    "clone": false,
    "patch": false,
    "search": "authored files"
  }
}
  "/Game/Mods/MaxCape/Items/ITEM_MaxCape.ITEM_MaxCape": {
    "$WearableBridge": true,
    "MaleMeshData": "/UmbralSands/Gameplay/Character/Player/Equipment/Cape/ITEM_Cape_Fire_MeshData_Male.ITEM_Cape_Fire_MeshData_Male",
    "FemaleMeshData": "/UmbralSands/Gameplay/Character/Player/Equipment/Cape/ITEM_Cape_Fire_MeshData_Female.ITEM_Cape_Fire_MeshData_Female"
  }
}

execute_process(COMMAND "${DUMPBIN}" /dependents "${BRIDGE}" RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect Helpy bridge imports: ${errors}")
endif()
string(TOLOWER "${imports}" imports)
if(imports MATCHES "windowscodecs|vulkan|sdl3|d3d11|d3d12|dxgi|d3dcompiler|opengl32")
  message(FATAL_ERROR "Game-side Helpy bridge eagerly imports a renderer: ${imports}")
endif()
execute_process(COMMAND "${DUMPBIN}" /imports "${HUD}" RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect HUD adapter imports: ${errors}")
endif()
string(TOLOWER "${imports}" imports)
string(FIND "${imports}" "delay load imports" delayed)
if(delayed LESS 0)
  message(FATAL_ERROR "HUD graphics libraries must remain delay-loaded")
endif()
string(SUBSTRING "${imports}" 0 ${delayed} eager)
if(eager MATCHES "d3d11.dll|d3d12.dll|dxgi.dll|d3dcompiler_47.dll|opengl32.dll")
  message(FATAL_ERROR "HUD eagerly imports graphics libraries")
endif()

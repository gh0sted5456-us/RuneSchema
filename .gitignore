# CMake and IDE output
build/
# Keep diagnostic source tooling available to the documentation CI. Generated
# build output remains ignored; only these authored scripts are allowlisted.
!/build/
/build/*
!/build/generate-diagnostics.py
!/build/audit-diagnostics.py
!/build/tests/
/build/tests/*
!/build/tests/diagnostics.py
!/build/tests/diagnostic-links.cjs
!/build/*.ps1
!/build/*.bat
!/build/*.py
!/build/*.json
!/build/tests/*.ps1
!/build/tests/*.py
build-*/
out/
outputs/
work/
.vs/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# Compiled artifacts
*.dll
*.exe
*.exp
*.ilk
*.lib
*.obj
*.pdb

# Local dependency cache, packaging and runtime data
.cache/
dist/
/plugins/
clean-base/
/runtime/
release/
example-mods/
RuneSchema/mods/
RuneSchema/config/

# Editor and operating-system files
.vscode/
*.user
*.suo
.DS_Store
Thumbs.db

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local MkDocs preview output.
/site/
/site-preview/

# Local chat attachments and immediate-mode UI state are not project sources.
/.codex-remote-attachments/
/imgui.ini

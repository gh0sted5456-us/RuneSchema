// RuneSchema plugin order. Entries are loaded top to bottom after dependencies.
// Set Enabled to false to disable a plugin. JSONC comments are allowed.
{
  "Plugins": [
    {
      "Id": "RSNetworking",
      "Enabled": true
    },
    {
      "Id": "RuneSchema.Helpy",
      "Enabled": true
    }
  ]
}

# Optional host companion. Generate an overlay translation unit; do not patch
# the pinned dependency checkout or change UE4SS's existing class/ABI layout.
get_target_property(_rs_host_sources UE4SS SOURCES)
set(_rs_program "")
foreach(_rs_file IN LISTS _rs_host_sources)
    if(_rs_file MATCHES "[/\\]UE4SSProgram\\.cpp$")
        set(_rs_program "${_rs_file}")
    endif()
endforeach()
if(NOT _rs_program)
    message(FATAL_ERROR "Managed host: upstream UE4SSProgram.cpp was not found")
endif()
file(READ "${_rs_program}" _rs_text)
set(_rs_host_root "${CMAKE_CURRENT_LIST_DIR}")
set(_rs_anchor "#include <UE4SSProgram.hpp>")
string(FIND "${_rs_text}" "${_rs_anchor}" _rs_found)
if(_rs_found LESS 0)
    message(FATAL_ERROR "Managed host: upstream include contract changed")
endif()
string(REPLACE "${_rs_anchor}" "${_rs_anchor}\n#include \"${_rs_host_root}/ManagedPackageQueue.h\"" _rs_text "${_rs_text}")
foreach(_rs_phase setup_mods start_cpp_mods start_lua_mods)
    if(_rs_phase STREQUAL "setup_mods")
        set(_rs_anchor "auto UE4SSProgram::setup_mods() -> void\n    {\n        ProfilerScope();")
        set(_rs_add "\n        RuneSchemaManagedPackages::Startup.Reset();")
    elseif(_rs_phase STREQUAL "start_cpp_mods")
        set(_rs_anchor "        // If this is the initial startup, notify mods that the UI has initialized.")
        set(_rs_add "#include \"${_rs_host_root}/RegisterNativePackages.inl\"\n")
    else()
        set(_rs_anchor "auto UE4SSProgram::start_lua_mods() -> void\n    {\n        ProfilerScope();\n        auto error_message = start_mods<LuaMod>();\n        if (!error_message.empty())\n        {\n            set_error(error_message.c_str());\n        }\n    }")
        string(REPLACE "\n    }" "\n#include \"${_rs_host_root}/StartLuaPackages.inl\"\n    }" _rs_lua_replacement "${_rs_anchor}")
    endif()
    string(FIND "${_rs_text}" "${_rs_anchor}" _rs_found)
    if(_rs_found LESS 0)
        message(FATAL_ERROR "Managed host: upstream ${_rs_phase} contract changed")
    endif()
    if(_rs_phase STREQUAL "start_lua_mods")
        string(REPLACE "${_rs_anchor}" "${_rs_lua_replacement}" _rs_text "${_rs_text}")
    elseif(_rs_phase STREQUAL "start_cpp_mods")
        string(REPLACE "${_rs_anchor}" "${_rs_add}${_rs_anchor}" _rs_text "${_rs_text}")
    else()
        string(REPLACE "${_rs_anchor}" "${_rs_anchor}${_rs_add}" _rs_text "${_rs_text}")
    endif()
endforeach()
set(_rs_anchor "        for (auto& mod : cpp_mods)\n        {")
string(FIND "${_rs_text}" "${_rs_anchor}" _rs_found)
if(_rs_found LESS 0)
    message(FATAL_ERROR "Managed host: upstream C++ teardown contract changed")
endif()
string(REPLACE "${_rs_anchor}"
    "        std::stable_partition(cpp_mods.begin(), cpp_mods.end(), [](auto* mod) { return RuneSchemaManagedPackages::Startup.Owns(std::wstring(mod->get_name())); });\n${_rs_anchor}"
    _rs_text "${_rs_text}")
set(_rs_overlay "${CMAKE_CURRENT_BINARY_DIR}/managed-host/UE4SSProgram.cpp")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/managed-host")
# configure_file COPYONLY avoids needlessly rebuilding an unchanged overlay.
file(WRITE "${_rs_overlay}.input" "${_rs_text}")
configure_file("${_rs_overlay}.input" "${_rs_overlay}" COPYONLY)
list(REMOVE_ITEM _rs_host_sources "${_rs_program}")
list(APPEND _rs_host_sources "${_rs_overlay}")
set_property(TARGET UE4SS PROPERTY SOURCES "${_rs_host_sources}")
message(STATUS "RuneSchema managed UE4SS host extension enabled (original checkout unchanged)")

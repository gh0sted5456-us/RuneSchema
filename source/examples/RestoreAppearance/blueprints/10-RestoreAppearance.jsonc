// Restores the existing Game Pass / WinGDK Edit Appearance control.
// Steam/GOG already exposes the native flow, so the runtime rule is skipped there.
{
  "/Game/UI/MainMenu/WBP_MainMenu_CharacterSelect": {
    "$RuntimeWidget": {
      "$Storefront": "GamePass",
      "$SkipMessage": "No need for this mod, please uninstall.",
      "Character.EditAppearanceButton": {
        "Visibility": "Visible",
        "bIsEnabled": true,
        "RenderOpacity": 1.0,
        "$Bind": {
          "Event": "OnButtonBaseClicked",
          "Target": "Character",
          "Function": "GoToEditAppearance"
        }
      },
      "InputLegend_EditAppearance": {
        "Visibility": "Visible",
        "bIsEnabled": true,
        "RenderOpacity": 1.0
      }
    }
  }
}
